{
  "expo": {
    "name": "Uncommon Intake",
    "slug": "uncommon-intake",
    "scheme": "uncommonintake",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.uncommon.intake",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "org.uncommon.intake",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Uncommon Intake uses the microphone to record your interview answers."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Uncommon Intake uses the camera to record short video interview answers.",
          "microphonePermission": "Uncommon Intake uses the microphone to record your interview answers.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0F3B95"
        }
      ],
      "expo-video",
      "expo-document-picker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
